{
  "expo": {
    "name": "FoodGo",
    "slug": "foodgo-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/panda-icon-v2.png",
    "scheme": "foodgofrontend",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/brand/panda-icon-v2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006C59",
        "foregroundImage": "./assets/images/brand/panda-adaptive-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/brand/panda-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF6",
          "image": "./assets/images/mascot/panda-courier.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
